# Copy this file to .env and fill in real values. .env is gitignored.
# See the README's "How to run it" section for step-by-step instructions on
# getting each of these for free.

# --- Supabase Postgres connection -------------------------------------------
# Project Settings -> Database -> Connection string (use the "Session pooler"
# tab, not "Direct connection" -- direct connections are IPv6-only on the
# free tier and often fail to connect from a typical home/office network).
#
# Split into separate fields rather than one JDBC URL so a password containing
# reserved characters (e.g. "#") never breaks anything. If your password does
# contain a "#", wrap it in double quotes below -- .env files treat an
# unquoted "#" as the start of a comment and will silently drop everything
# after it, e.g. SUPABASE_DB_PASSWORD="#your-password"
SUPABASE_DB_HOST=aws-0-xx-xxxx-x.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.xxxxxxxxxxxxxxxxxxxx
SUPABASE_DB_PASSWORD=your-database-password

# --- Gemini API key (Google AI Studio, free tier) ---------------------------
# Get one at https://aistudio.google.com/apikey
# Used by the ADK agent's reasoning step over the RuleCheckTool and
# UrlhausCheckTool tool outputs.
GOOGLE_API_KEY=your-gemini-api-key

# --- URLhaus Auth-Key (abuse.ch, free) --------------------------------------
# Get one at https://auth.abuse.ch/ (sign in, then generate a key).
# Used by UrlhausCheckTool to check URLs against URLhaus's malware database.
URLHAUS_AUTH_KEY=your-urlhaus-auth-key
